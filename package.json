{
  "name": "gcclippy",
  "version": "0.2.0",
  "scripts": {
    "dev": "concurrently -n server,client \"npx tsx src/server/index.ts\" \"npx vite\"",
    "dev:server": "npx tsx src/server/index.ts",
    "dev:client": "npx vite",
    "build": "npx vite build",
    "start": "NODE_ENV=production npx tsx src/server/index.ts",
    "lint": "eslint"
  },
  "bin": {
    "clippy": "./bin/clippy.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "lucide-react": "^1.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.14.2",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
