{
  "name": "pilot-console",
  "version": "0.2.0",
  "description": "A GitHub Copilot CLI session manager with a web dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiongl/clippy.git"
  },
  "bugs": {
    "url": "https://github.com/tiongl/clippy/issues"
  },
  "homepage": "https://github.com/tiongl/clippy#readme",
  "keywords": [
    "github-copilot",
    "copilot-cli",
    "dashboard",
    "terminal",
    "automation"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "files": [
    "bin/",
    "dist/",
    "public/pilot-console-logo.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev:server\" \"npx vite\"",
    "dev:server": "npx tsx watch --exclude \"src/client/**\" --exclude \"src/daemon/**\" --exclude \"src/test/**\" src/server/index.ts",
    "dev:client": "npx vite",
    "daemon": "npx tsx src/daemon/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npx vite build",
    "build:server": "npx tsup",
    "start": "cross-env NODE_ENV=production npx tsx src/server/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:screens": "node scripts/docs-screenshots/capture.mjs",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "pilot-console": "./bin/pilot-console.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@github/copilot-sdk": "^1.0.6",
    "@monaco-editor/react": "^4.7.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.5.0",
    "diff2html": "^3.4.56",
    "express": "^5.2.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "^7.14.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.49.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  }
}
